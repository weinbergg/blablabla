# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# locally uploaded library files
/public/uploads/*
!/public/uploads/.gitkeep

# database
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
/*.db
/*.db-*
/*.sqlite
/*.sqlite-*
/*.sqlite3
/*.sqlite3-*
/data/**/*.db
/data/**/*.db-*
/data/**/*.sqlite
/data/**/*.sqlite-*
/data/**/*.sqlite3
/data/**/*.sqlite3-*
/data/backups/
/data/maintenance.json
/backups/
/static-assets/
/releases/
/drizzle/meta

# scratch conversion workspace
/tmp-conversions

# raw source material dropped into the repo for import — never committed,
# only ever read once and copied into /public/uploads by the import scripts
/литература
/BOOKS

# regenerated by postinstall (scripts/copy-pdf-worker.mjs)
/public/pdf.worker.min.mjs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local design experiments — not for production until approved
/app/design-preview/

# local playbooks and seed data — never GitHub
/local-demo/
/app/local-demo/

# local book staging for imports
/import-staging/

# in-flight browser uploads streamed to disk before they're committed
/data/tmp-uploads/
/data/community-uploads/
/data/music-uploads/

# local dumps, legal source docs, scratch notes — never deploy
/*.zip
/Downloads.zip
/*.docx
/NOTES.md
/TODO.md
/scratch.md


# Local verification copies, credentials and browser artifacts
/data/implementation-checks/

# Browser output (keep tests/, test helpers and intentional fixtures versioned)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/tests/.auth/
/screenshots/
/.epub-*.png
/.epub-*-dom.html
/logs/
/*.log

# Machine-specific editor/agent state; project AGENTS.md/CLAUDE.md remain tracked
/.codex/
/.cursor/
/.idea/
/.vscode/*.local.json
*.swp
*.swo
Thumbs.db
