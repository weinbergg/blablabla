# Путь к файлу SQLite (по умолчанию ./data/app.db, менять обычно не нужно)
DATABASE_PATH=./data/app.db

# Нужен только при повторном запуске scripts/seed.ts (одноразовый импорт
# исходной папки с книгами). Для обычной работы сайта не используется.
BOOKS_SOURCE_DIR=/Users/georgij/Desktop/BOOKS

# ЮKassa: нужны ДВЕ величины, не один ключ.
# Кабинет → магазин → Настройки → Ключи API
#   shopId  — короткий номер магазина (цифры)
#   secret  — секретный ключ (длинная строка, начинается часто с live_ или test_)
# Секреты пишите в .env.local (он в git не попадает), не сюда.
#
# Тестовый магазин (песочница, настоящие деньги не списываются, СБП обычно нет):
YOOKASSA_TEST_SHOP_ID=
YOOKASSA_TEST_SECRET_KEY=
#
# Боевой магазин (реальные рубли, СБП и QR):
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Публичный адрес сайта (ссылки в письмах о подписке)
PUBLIC_URL=https://blablablarden.ru

# Секрет для GET /api/cron/billing (cron на VPS). Длинная случайная строка.
CRON_SECRET=

# Почта напоминаний об окончании/автоплатеже (оферта 5.5). Без SMTP письма
# не уходят, но баннер в шапке всё равно показывается.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
MAIL_FROM=blablablarden@mail.ru

